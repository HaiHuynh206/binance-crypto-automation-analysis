# Airflow
AIRFLOW_UID=50000
AIRFLOW_WEB_BIND=0.0.0.0
AIRFLOW_WEB_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# Ingestion
CRYPTO_DATA_ROOT=./data
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT
CRYPTO_DATASETS=klines_1s,klines_1m,agg_trades,funding_rate,open_interest
CRYPTO_WEIGHT_PER_MINUTE=2400
CRYPTO_LOOKBACK_HOURS=24
CRYPTO_MAX_PAGES=5000
CRYPTO_HTTP_TIMEOUT=20

# Data quality gate before Gold: comma separated statuses that stop the run
# (missing, partial, id_gaps).
CRYPTO_DQ_FAIL_ON=missing

# Medallion rollout switch. 0 keeps the DAG on the Bronze-only flow and makes
# S3 publish skip Silver/Gold (manual CLI commands still work).
CRYPTO_MEDALLION_ENABLED=1

# S3-compatible storage (Cloudflare R2 recommended).
# Leave CRYPTO_S3_BUCKET blank to disable publishing.
# R2 endpoint: https://<account-id>.r2.cloudflarestorage.com, region: auto
CRYPTO_S3_BUCKET=
CRYPTO_S3_PREFIX=crypto
CRYPTO_S3_ENDPOINT_URL=
CRYPTO_S3_REGION=auto
# Optional canned ACL, e.g. public-read on AWS S3. Leave blank for R2/MinIO.
CRYPTO_S3_ACL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
