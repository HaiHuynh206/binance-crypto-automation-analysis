CRYPTO_S3_BUCKET=crypto-lake
CRYPTO_S3_PREFIX=crypto
CRYPTO_S3_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Sample path (Hive partitions):
# s3://crypto-lake/crypto/lake/exchange=binance/dataset=klines_1m/**/*.parquet
